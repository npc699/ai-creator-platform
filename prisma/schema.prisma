// 数据模型单一来源：PostgreSQL 表结构、枚举与索引；Client 生成到 lib/generated/prisma。
// 变更后执行 db:generate，开发环境还需递增 lib/db/prisma.ts 的 PRISMA_CLIENT_CACHE_KEY。

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  PASSED
  REJECTED
  FLAGGED
}

enum ReviewRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum ReviewType {
  PUBLISH
  UPDATE
  MANUAL
  FIX
}

enum Role {
  USER
  ADMIN
}

enum AssetSource {
  UPLOAD
  AI
}

enum PromptCategory {
  LONG_FORM
  SHORT_POST
  SEEDING
  PRODUCT_REVIEW
  INDUSTRY
  TITLE_GEN
  REWRITE
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  image        String?
  bio          String?  @db.Text
  role         Role     @default(USER)
  posts        Post[]
  postLikes      PostLike[]
  postViews      PostView[]
  reviewRecords ReviewRecord[]
  drafts       Draft[]
  prompts         Prompt[]
  promptFavorites PromptFavorite[]
  assets          Asset[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Asset {
  id        String      @id @default(cuid())
  name      String
  url       String
  mimeType  String?
  sizeBytes Int?
  source    AssetSource
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Prompt {
  id         String           @id @default(cuid())
  title      String
  content    String
  category   PromptCategory   @default(LONG_FORM)
  isOfficial Boolean          @default(false)
  isFavorite Boolean          @default(false)
  usageCount Int              @default(0)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts     Draft[]
  posts      Post[]
  favorites  PromptFavorite[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isFavorite])
  @@index([isOfficial])
  @@index([isOfficial, category])
}

model PromptFavorite {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
  @@index([promptId])
}

model Draft {
  id           String   @id @default(cuid())
  title        String
  content      String
  userId       String
  promptId     String?
  /** 非空表示该草稿是某篇已发布文章的编辑层，自动保存只写此处，不直接改 Post。 */
  sourcePostId String?  @unique
  tags         String[] @default([])
  /** 列表封面图，独立于正文 HTML。 */
  coverUrl     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt       Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)
  publishedAs  Post?    @relation("PublishedFromDraft")
  sourcePost   Post?    @relation("PostEditDraft", fields: [sourcePostId], references: [id], onDelete: Cascade)
  reviewRecords ReviewRecord[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([promptId])
  @@index([sourcePostId])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int        @default(0)
  likeCount   Int        @default(0)
  /** 热点榜预计算分，由定时任务刷新。 */
  hotScore    Float      @default(0)
  /** 爆文榜预计算分，由定时任务刷新。 */
  viralScore  Float      @default(0)
  scoreUpdatedAt DateTime?
  tags        String[]   @default([])
  /** 列表封面图，独立于正文 HTML。 */
  coverUrl    String?
  qualityScore Float?
  reviewStatus ReviewStatus @default(PENDING)
  reviewRiskLevel ReviewRiskLevel @default(NONE)
  reviewedAt  DateTime?
  userId      String
  promptId    String?
  draftId     String?    @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      Prompt?    @relation(fields: [promptId], references: [id], onDelete: SetNull)
  draft       Draft?     @relation("PublishedFromDraft", fields: [draftId], references: [id], onDelete: SetNull)
  editDraft   Draft?     @relation("PostEditDraft")
  likes       PostLike[]
  views       PostView[]
  reviewRecords ReviewRecord[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([promptId])
  @@index([status])
  @@index([reviewStatus])
  @@index([reviewRiskLevel])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, likeCount(sort: Desc), publishedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc), publishedAt(sort: Desc)])
  @@index([status, hotScore(sort: Desc), publishedAt(sort: Desc)])
  @@index([status, viralScore(sort: Desc), publishedAt(sort: Desc)])
}

/** AI 审核记录保留每次判定快照，便于追溯误判与 Prompt 迭代。 */
model ReviewRecord {
  id           String          @id @default(cuid())
  postId       String?
  draftId      String?
  userId       String
  reviewType   ReviewType
  contentHash  String
  passed       Boolean
  riskLevel    ReviewRiskLevel
  categories   String[]        @default([])
  qualityScore Float?
  result       Json
  post         Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  draft        Draft?          @relation(fields: [draftId], references: [id], onDelete: SetNull)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@index([postId, createdAt(sort: Desc)])
  @@index([draftId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([contentHash])
  @@index([riskLevel])
}

/** 用户对文章的点赞记录，likeCount 为冗余计数便于排序。 */
model PostLike {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/** 阅读去重：同一 viewerKey（登录用户 id 或匿名 Cookie）对同一文章只计一次。 */
model PostView {
  postId    String
  viewerKey String
  userId    String?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@id([postId, viewerKey])
  @@index([postId])
  @@index([userId])
}
