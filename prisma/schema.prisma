// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Role {
  USER
  ADMIN
}

enum AssetSource {
  UPLOAD
  AI
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  image        String?
  role         Role     @default(USER)
  posts        Post[]
  postLikes    PostLike[]
  postViews    PostView[]
  drafts       Draft[]
  prompts      Prompt[]
  assets       Asset[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Asset {
  id        String      @id @default(cuid())
  name      String
  url       String
  mimeType  String?
  sizeBytes Int?
  source    AssetSource
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Prompt {
  id        String   @id @default(cuid())
  title     String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts    Draft[]
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Draft {
  id        String   @id @default(cuid())
  title     String
  content   String
  userId    String
  promptId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)
  post      Post?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([promptId])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int        @default(0)
  likeCount   Int        @default(0)
  userId      String
  promptId    String?
  draftId     String?    @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      Prompt?    @relation(fields: [promptId], references: [id], onDelete: SetNull)
  draft       Draft?     @relation(fields: [draftId], references: [id], onDelete: SetNull)
  likes       PostLike[]
  views       PostView[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([promptId])
  @@index([status])
}

/** 用户对文章的点赞记录，likeCount 为冗余计数便于排序。 */
model PostLike {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/** 阅读去重：同一 viewerKey（登录用户 id 或匿名 Cookie）对同一文章只计一次。 */
model PostView {
  postId    String
  viewerKey String
  userId    String?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@id([postId, viewerKey])
  @@index([postId])
  @@index([userId])
}
